---
import { existsSync } from 'node:fs';
import { doctor, contact, nav } from '../data/site';
import Icon from './Icon.astro';

// A 150px Instagram profile picture is useless as a hero portrait but
// perfectly sharp at 36px. Drop it at public/images/avatar.jpg.
const avatar = '/images/avatar.jpg';
const hasAvatar = existsSync(new URL(`../../public${avatar}`, import.meta.url));
---

<header
  class="sticky top-0 z-40 border-b border-cream-200/70 bg-cream-50/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
    <a href="#top" class="group flex items-center gap-3">
      {
        hasAvatar ? (
          <img
            src={avatar}
            alt=""
            width="36"
            height="36"
            class="h-9 w-9 rounded-full object-cover ring-1 ring-plum-900/10"
          />
        ) : (
          <span class="grid h-9 w-9 place-items-center rounded-full bg-rose-500 font-display text-sm text-white">
            AM
          </span>
        )
      }
      <span class="leading-tight">
        <span class="block font-display text-base text-plum-900">{doctor.name}</span>
        <span class="block text-[11px] tracking-wide text-plum-500 uppercase"
          >{doctor.title}</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-navlink
            class="relative text-sm text-plum-700 transition after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:rounded-full after:bg-rose-500 after:transition-transform after:duration-200 hover:text-rose-600 aria-[current]:text-rose-600 aria-[current]:after:scale-x-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={contact.bookingUrl}
      class="hidden items-center gap-2 rounded-full bg-plum-900 px-5 py-2.5 text-sm font-medium text-cream-50 shadow-soft transition hover:bg-plum-700 sm:inline-flex"
    >
      Book an appointment
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
</header>

<script>
  /*
    Scrollspy: highlight the nav link for the section currently in view.

    A section counts as "current" once its top passes under the sticky
    header and before it leaves the upper part of the viewport. When two
    qualify at once — a short section fully on screen above a long one —
    the earliest in document order wins, which is what reading position
    actually feels like.
  */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-navlink]')];

  const sections = links
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      const el = id ? document.getElementById(id) : null;
      return el ? { link, el } : null;
    })
    .filter((s): s is { link: HTMLAnchorElement; el: HTMLElement } => s !== null);

  if (sections.length) {
    const visible = new Set<string>();

    const setCurrent = (target: HTMLAnchorElement | null) => {
      for (const { link } of sections) {
        if (link === target) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const update = () => {
      // Bottom of the page: the last section can never reach the top of
      // the viewport, so pin it explicitly.
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.offsetHeight - 2;
      if (atBottom) {
        setCurrent(sections[sections.length - 1].link);
        return;
      }
      const current = sections.find((s) => visible.has(s.el.id));
      setCurrent(current ? current.link : null);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        update();
      },
      // Top inset clears the sticky header; the bottom inset means a
      // section only becomes current once it reaches the upper third.
      { rootMargin: '-72px 0px -66% 0px', threshold: 0 }
    );

    for (const { el } of sections) observer.observe(el);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
