---
import { existsSync } from 'node:fs';
import { doctor, nav } from '../data/site';

// A 150px Instagram profile picture is useless as a hero portrait but
// perfectly sharp at 30px. Drop it at public/images/avatar.jpg.
const avatar = '/images/avatar.jpg';
const hasAvatar = existsSync(new URL('../../public/images/avatar.jpg', import.meta.url));
---

<header
  class="sticky top-0 z-30 border-b border-plum-900/[0.07] bg-cream-50/90 backdrop-blur-[14px]"
>
  <div class="shell flex items-center justify-between gap-3 py-[11px]">
    <a href="#top" class="flex items-center gap-[9px]">
      {
        hasAvatar ? (
          <img
            src={avatar}
            alt=""
            width="30"
            height="30"
            class="h-[30px] w-[30px] rounded-full object-cover ring-1 ring-plum-900/10"
          />
        ) : (
          <span class="grid h-[30px] w-[30px] place-items-center rounded-full bg-rose-500 font-display text-[11px] text-white">
            AM
          </span>
        )
      }
      <span class="font-display text-[16px] tracking-[-0.02em] text-plum-900 md:whitespace-nowrap">
        {doctor.name}
      </span>
    </a>

    <nav class="hidden items-center gap-[26px] md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-navlink
            class="relative text-[13.5px] text-plum-700 transition after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-full after:origin-left after:scale-x-0 after:rounded-full after:bg-rose-500 after:transition-transform hover:text-rose-600 aria-[current]:text-rose-600 aria-[current]:after:scale-x-100"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#book"
        class="rounded-full bg-plum-900 px-5 py-2.5 text-[13.5px] font-medium text-cream-50 transition hover:bg-plum-700"
      >
        Book
      </a>
    </nav>

    <!-- Phone menu trigger. 36px circle, 44px hit area via padding. -->
    <button
      type="button"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      class="-m-1 grid h-11 w-11 shrink-0 place-items-center rounded-full text-plum-700 md:hidden"
    >
      <span
        class="grid h-9 w-9 place-items-center rounded-full border border-plum-900/[0.14]"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path class="menu-open-icon" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-close-icon hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </span>
    </button>
  </div>

  <!-- Collapsible panel. `hidden` keeps it out of the keyboard and
       screen-reader order while closed. -->
  <div id="mobile-menu" hidden class="border-t border-plum-900/[0.07] md:hidden">
    <nav class="shell py-2" aria-label="Mobile">
      <ul class="divide-y divide-plum-900/[0.07]">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-mobile-navlink
                class="block py-3.5 text-[15px] text-plum-700 aria-[current]:font-medium aria-[current]:text-rose-600"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="#book"
        class="mt-3 mb-3 flex items-center justify-center rounded-full bg-plum-900 px-5 py-3.5 text-[14px] font-medium text-cream-50"
      >
        Book an appointment
      </a>
    </nav>
  </div>
</header>

<script>
  /*
    Scrollspy: highlight the nav link for the section currently in view.

    A section counts as "current" once its top passes under the sticky
    header and before it leaves the upper part of the viewport. When two
    qualify at once the earliest in document order wins, which matches
    reading position.
  */
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      'a[data-navlink], a[data-mobile-navlink]'
    ),
  ];

  // One section can be represented by two links — desktop and mobile —
  // so each entry carries every link pointing at it.
  const sections = [...new Set(links.map((l) => l.getAttribute('href')))]
    .map((href) => {
      const el = href ? document.getElementById(href.slice(1)) : null;
      return el ? { el, links: links.filter((l) => l.getAttribute('href') === href) } : null;
    })
    .filter((s): s is { el: HTMLElement; links: HTMLAnchorElement[] } => s !== null);

  if (sections.length) {
    const visible = new Set<string>();

    const setCurrent = (target: HTMLElement | null) => {
      for (const section of sections) {
        const on = section.el === target;
        for (const link of section.links) {
          if (on) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    };

    const update = () => {
      // A final short section can never reach the top of the viewport,
      // so pin the last link at the bottom of the page.
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.offsetHeight - 2;
      if (atBottom) {
        setCurrent(sections[sections.length - 1].el);
        return;
      }
      const current = sections.find((s) => visible.has(s.el.id));
      setCurrent(current ? current.el : null);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        update();
      },
      { rootMargin: '-72px 0px -66% 0px', threshold: 0 }
    );

    for (const { el } of sections) observer.observe(el);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  /* --------------------------- mobile menu --------------------------- */
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const openIcon = toggle.querySelector('.menu-open-icon');
    const closeIcon = toggle.querySelector('.menu-close-icon');

    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () =>
      setMenu(toggle.getAttribute('aria-expanded') !== 'true')
    );

    // Anchor links jump within the page, so the panel has to close itself
    // or it covers the section the tap just navigated to.
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => setMenu(false));
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setMenu(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!menu.hidden && !menu.contains(target) && !toggle.contains(target)) {
        setMenu(false);
      }
    });

    // Crossing to the desktop breakpoint would otherwise strand the panel
    // open behind the desktop nav.
    window.matchMedia('(min-width: 760px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false);
    });
  }
</script>
