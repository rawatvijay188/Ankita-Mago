---
import { contact } from '../data/site';
import Icon from './Icon.astro';
---

<!-- Sticky action bar: phones only. Most patients arrive on mobile,
     so calling and booking are never more than one thumb away. -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-cream-200 bg-cream-50/95 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur-md lg:hidden"
>
  <div class="flex gap-3">
    <a
      href={contact.phoneHref}
      class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-plum-900/15 bg-white py-3.5 text-sm font-medium text-plum-900"
    >
      <Icon name="phone" class="h-4 w-4" /> Call
    </a>
    <a
      href={contact.whatsappHref}
      target="_blank"
      rel="noopener"
      class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-plum-900/15 bg-white py-3.5 text-sm font-medium text-plum-900"
    >
      <Icon name="chat" class="h-4 w-4" /> WhatsApp
    </a>
    <a
      href="#book"
      class="inline-flex flex-[1.3] items-center justify-center gap-2 rounded-full bg-rose-500 py-3.5 text-sm font-medium text-white shadow-soft"
    >
      Book
    </a>
  </div>
</div>

<!-- keeps the bar from covering the footer -->
<div class="h-24 lg:hidden" aria-hidden="true"></div>
