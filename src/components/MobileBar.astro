---
import { contact } from '../data/site';
import Icon from './Icon.astro';

/*
  Sticky rather than fixed: it sits in normal flow and pulls itself up over
  the footer's spacer with a negative margin, so it never overlaps content
  or needs body padding to compensate.
*/
---

<div
  class="sticky bottom-0 z-40 -mt-[92px] grid grid-cols-[1fr_1fr_1.35fr] gap-2 border-t border-plum-900/10 bg-cream-50/95 px-3.5 pt-2.5 pb-4 backdrop-blur-[14px] md:hidden"
>
  <a
    href={contact.phoneHref}
    class="flex min-h-[50px] items-center justify-center gap-[7px] rounded-full bg-white text-[14px] font-medium text-plum-900 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.14)]"
  >
    <Icon name="phone" class="h-[15px] w-[15px]" />
    Call
  </a>
  <a
    href={contact.whatsappHref}
    target="_blank"
    rel="noopener"
    class="flex min-h-[50px] items-center justify-center gap-[7px] rounded-full bg-white text-[14px] font-medium text-plum-900 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.14)]"
  >
    <Icon name="chat" class="h-[15px] w-[15px]" />
    WhatsApp
  </a>
  <a
    href="#book"
    class="flex min-h-[50px] items-center justify-center gap-2 rounded-full bg-rose-500 text-[15px] font-medium text-white"
  >
    Book
    <Icon name="arrow" class="h-3.5 w-3.5" />
  </a>
</div>
