---
import { doctor, values, credentials } from '../data/site';
import Icon from './Icon.astro';

/*
  Credentials used to be a full section with two timelines. For a doctor
  people already trust from Instagram, the degrees are reassurance you
  check rather than the argument that wins you — so they collapse.
*/
---

<section id="about" class="px-[18px] py-11 md:px-10">
  <p class="text-[10.5px] tracking-[0.18em] text-rose-600 uppercase">About</p>

  <p
    class="opsz-quote mt-4 max-w-3xl font-display text-[23px] leading-[1.38] tracking-[-0.025em] text-plum-900 md:text-[28px]"
  >
    {doctor.quote}
  </p>

  <p class="mt-[18px] max-w-3xl text-[15px] leading-[1.7] text-plum-500">
    <span class="ph-mark">[Placeholder bio — her own words.]</span>
    {doctor.intro.replace('[Placeholder bio — her own words.]', '')}
  </p>

  <div class="mt-6 flex flex-col gap-px border-t border-plum-900/10 bg-plum-900/10">
    {
      values.map((v) => (
        <div class="flex gap-3.5 bg-cream-50 py-[18px]">
          <span class="shrink-0 text-rose-500">
            <Icon name={v.icon} class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-display text-[18px] tracking-[-0.02em] text-plum-900">
              {v.title}
            </span>
            <span class="mt-1.5 block max-w-2xl text-[14px] leading-[1.6] text-plum-500">
              {v.body}
            </span>
          </span>
        </div>
      ))
    }
  </div>

  <details class="group mt-6 rounded-[14px] bg-cream-100 p-[22px]">
    <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4">
      <span class="font-display text-[19px] tracking-[-0.02em] text-plum-900">
        Credentials &amp; training
      </span>
      <span class="shrink-0 text-plum-400 transition group-open:rotate-180">
        <Icon name="chevron" class="h-[15px] w-[15px]" />
      </span>
    </summary>

    <ol class="mt-4 border-t border-plum-900/[0.12]">
      {
        credentials.education.map((item) => (
          <li class="grid grid-cols-[56px_1fr] gap-3.5 border-b border-plum-900/[0.09] py-3.5">
            <span class="pt-[3px] font-mono text-[11.5px] text-plum-400">
              <span class="ph-mark">{item.year}</span>
            </span>
            <span>
              <span class="block font-display text-[17px] text-plum-900">{item.title}</span>
              <span class="mt-[3px] block text-[13.5px] text-plum-500">
                <span class="ph-mark">{item.place}</span>
              </span>
            </span>
          </li>
        ))
      }
    </ol>

    <ul class="mt-4 flex flex-wrap gap-[7px]">
      {
        credentials.memberships.map((m) => (
          <li class="rounded-full bg-white px-3.5 py-[7px] text-[12.5px] text-plum-700">
            <span class="ph-mark">{m}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-3.5 text-[12px] leading-[1.6] text-plum-400">
      Every line came from a public directory and needs her confirmation — the sources
      disagree on dates.
    </p>
  </details>
</section>
