---
import { services } from '../data/site';
import Icon from './Icon.astro';

/*
  Six equal cards was most of a screen and read as filler. The specialty
  gets a full-width card; everything else collapses, so the section states
  what she does in one screen and expands only if you care.
*/
const featured = services.find((s) => s.featured)!;
const rest = services.filter((s) => !s.featured);
---

<section
  id="services"
  class="border-t border-plum-900/[0.07] bg-cream-100 px-[18px] pt-11 pb-12 md:px-10"
>
  <p class="text-[10.5px] tracking-[0.18em] text-rose-600 uppercase">Care</p>
  <h2 class="opsz-title mt-3 text-[30px] leading-[1.08] text-plum-900 md:text-[40px]">
    Fertility first — and everything after
  </h2>

  <div class="mt-6 flex flex-col gap-3 md:grid md:grid-cols-2 md:items-start">
    <div class="rounded-[14px] bg-plum-900 p-[22px] text-cream-100 md:col-span-2">
      <div class="flex items-center justify-between gap-3.5">
        <span
          class="font-display text-[11.5px] tracking-[0.14em] text-rose-400 uppercase"
        >
          Specialty
        </span>
        <span class="text-rose-400"><Icon name={featured.icon} class="h-[22px] w-[22px]" /></span>
      </div>
      <h3 class="opsz-title mt-3.5 text-[28px] leading-[1.1] text-cream-50">
        {featured.title}
      </h3>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.65] text-cream-100/70">
        {featured.blurb}
      </p>
      <ul class="mt-[18px] flex flex-wrap gap-[7px]">
        {
          featured.points.map((p) => (
            <li class="rounded-full border border-cream-100/20 px-3.5 py-[7px] text-[12.5px] text-cream-100/90">
              {p.includes('[') ? <span class="ph-mark text-cream-50">{p}</span> : p}
            </li>
          ))
        }
      </ul>
    </div>

    {
      rest.map((s) => (
        <details class="group rounded-[14px] bg-white p-[22px] ring-1 ring-plum-900/[0.07]">
          <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4">
            <span class="flex items-center gap-3">
              <span class="text-rose-500">
                <Icon name={s.icon} class="h-[21px] w-[21px]" />
              </span>
              <span class="font-display text-[19px] leading-[1.2] tracking-[-0.02em] text-plum-900">
                {s.title}
              </span>
            </span>
            <span class="shrink-0 text-plum-400 transition group-open:rotate-180">
              <Icon name="chevron" class="h-[15px] w-[15px]" />
            </span>
          </summary>
          <p class="mt-3.5 text-[14.5px] leading-[1.65] text-plum-500">
            {s.blurb.includes('[') ? <span class="ph-mark">{s.blurb}</span> : s.blurb}
          </p>
          <ul class="mt-3.5 flex flex-wrap gap-[7px]">
            {s.points.map((p) => (
              <li class="rounded-full border border-plum-900/[0.12] px-3.5 py-[7px] text-[12.5px] text-plum-700">
                {p.includes('[') ? <span class="ph-mark">{p}</span> : p}
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</section>
