---
import { services, contact } from '../data/site';
import Icon from './Icon.astro';
---

<section id="services" class="bg-cream-100 py-14 sm:py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-medium tracking-[0.2em] text-rose-500 uppercase">Services</p>
      <h2 class="mt-4 text-[1.6rem] leading-tight text-plum-900 sm:text-4xl">
        Fertility first — and everything after
      </h2>
      <p class="mt-4 text-base text-plum-700 sm:text-lg">
        Conception, pregnancy, surgery and long-term gynaecological care, with the
        same doctor through all of it.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <article
            class:list={[
              'group flex flex-col rounded-2xl p-6 shadow-soft transition hover:shadow-lift',
              s.featured
                ? 'bg-white ring-2 ring-rose-400'
                : 'bg-white ring-1 ring-plum-900/[0.04]',
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-rose-100 text-rose-500 transition group-hover:bg-rose-500 group-hover:text-white">
                <Icon name={s.icon} class="h-5.5 w-5.5" />
              </span>
              {s.featured && (
                <span class="rounded-full bg-rose-100 px-3 py-1 text-[11px] font-medium tracking-wide text-rose-600 uppercase">
                  Specialty
                </span>
              )}
            </div>
            <h3 class="mt-5 text-lg text-plum-900 sm:text-xl">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-plum-500">{s.blurb}</p>
            <ul class="mt-5 space-y-2 border-t border-cream-200 pt-5">
              {s.points.map((p) => (
                <li class="flex items-start gap-2.5 text-sm text-plum-700">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-sage-500" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-plum-500">
      Not sure which applies to you?
      <a href={contact.bookingUrl} class="font-medium text-rose-600 underline underline-offset-4">
        Book a consultation
      </a>
      and we will work it out together.
    </p>
  </div>
</section>
