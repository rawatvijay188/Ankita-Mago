---
import { credentials } from '../data/site';
import Icon from './Icon.astro';

const columns = [
  { heading: 'Education', items: credentials.education },
  { heading: 'Experience', items: credentials.experience },
];
---

<section id="credentials" class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
  <div class="max-w-2xl">
    <p class="text-xs font-medium tracking-[0.2em] text-rose-500 uppercase">Credentials</p>
    <h2 class="mt-4 text-3xl leading-tight text-plum-900 sm:text-4xl">
      Trained, certified, and still learning
    </h2>
  </div>

  <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
    {
      columns.map((col) => (
        <div>
          <h3 class="text-sm font-medium tracking-wide text-plum-500 uppercase">
            {col.heading}
          </h3>
          <ol class="mt-6 space-y-0">
            {col.items.map((item) => (
              <li class="relative border-l border-cream-200 pb-8 pl-7 last:pb-0">
                <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-rose-400 ring-4 ring-cream-50" />
                <p class="font-display text-lg text-plum-900">
                  <span class="ph-mark">{item.title}</span>
                </p>
                <p class="mt-1 text-sm text-plum-700">
                  <span class="ph-mark">{item.place}</span>
                </p>
                <p class="mt-1 text-xs tracking-wide text-plum-500 uppercase">
                  <span class="ph-mark">{item.year}</span>
                </p>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <div class="mt-14 rounded-2xl border border-cream-200 bg-white p-7 shadow-soft">
    <h3 class="text-sm font-medium tracking-wide text-plum-500 uppercase">
      Professional memberships
    </h3>
    <ul class="mt-5 flex flex-wrap gap-3">
      {
        credentials.memberships.map((m) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-cream-100 px-4 py-2 text-sm text-plum-700">
            <Icon name="shield" class="h-4 w-4 text-sage-500" />
            <span class="ph-mark">{m}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
