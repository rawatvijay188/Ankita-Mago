---
import { doctor, contact, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-cream-200 bg-cream-50">
  <div class="mx-auto max-w-6xl px-5 py-14 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-display text-xl text-plum-900">{doctor.name}</p>
        <p class="mt-1 text-sm text-plum-500">
          {doctor.title} · <span class="ph-mark">{doctor.qualifications}</span>
        </p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-plum-500">
          {doctor.tagline}
        </p>
      </div>

      <div>
        <p class="text-sm font-medium text-plum-900">Explore</p>
        <ul class="mt-3 space-y-2">
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="text-sm text-plum-500 transition hover:text-rose-600">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-plum-900">Contact</p>
        <ul class="mt-3 space-y-2 text-sm text-plum-500">
          <li>
            <a href={contact.phoneHref} class="transition hover:text-rose-600">
              <span class="ph-mark">{contact.phone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="transition hover:text-rose-600">
              <span class="ph-mark">{contact.email}</span>
            </a>
          </li>
          <li><span class="ph-mark">{contact.addressLines.join(', ')}</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-cream-200 pt-6">
      <p class="text-xs leading-relaxed text-plum-500">
        The information on this website is general and does not replace a medical
        consultation. If you have an urgent medical concern, contact the clinic or
        your nearest emergency department.
      </p>
      <p class="mt-3 text-xs text-plum-500">
        © {year} {doctor.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
