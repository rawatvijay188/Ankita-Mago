---
import { doctor, footerNav, social } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-plum-900 px-[18px] pt-10 pb-8 text-cream-100 md:px-10">
  <p class="opsz-title font-display text-[26px] tracking-[-0.03em] text-cream-50">
    {doctor.name}
  </p>
  <p class="mt-2 text-[13.5px] leading-[1.7] text-cream-100/65">
    {doctor.title} · <span class="ph-mark text-cream-50">{doctor.qualifications}</span>
  </p>

  <ul
    class="mt-[26px] grid grid-cols-2 gap-x-5 gap-y-3.5 border-t border-cream-100/[0.14] pt-[22px] md:grid-cols-3"
  >
    {
      footerNav.map((n) => (
        <li>
          <a href={n.href} class="text-[14.5px] text-cream-100/70 transition hover:text-cream-50">
            {n.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-[26px] flex gap-2.5">
    <a
      href={social.instagram}
      target="_blank"
      rel="noopener"
      class="rounded-full border border-cream-100/20 px-[18px] py-2.5 text-[13.5px] text-cream-100 transition hover:border-cream-100/50"
    >
      Instagram
    </a>
    <a
      href={social.threads}
      target="_blank"
      rel="noopener"
      class="rounded-full border border-cream-100/20 px-[18px] py-2.5 text-[13.5px] text-cream-100 transition hover:border-cream-100/50"
    >
      Threads
    </a>
  </div>

  <p
    class="mt-7 border-t border-cream-100/[0.14] pt-5 text-[11.5px] leading-[1.7] text-cream-100/45"
  >
    The information here is general and does not replace a medical consultation. For an
    urgent concern, contact the clinic or your nearest emergency department.
  </p>
  <p class="mt-2.5 text-[11.5px] text-cream-100/45">© {year} {doctor.name}</p>

  <!-- Clearance for the sticky action bar, which pulls itself up over
       this space with a negative margin. -->
  <div class="h-[76px] md:hidden" aria-hidden="true"></div>
</footer>
