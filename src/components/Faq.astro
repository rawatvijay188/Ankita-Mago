---
import { faqs } from '../data/site';
import Icon from './Icon.astro';
---

<section id="faq" class="pt-11 pb-10">
  <div class="shell">
  <p class="text-[10.5px] tracking-[0.18em] text-rose-600 uppercase">
    Before you come in
  </p>
  <h2 class="opsz-title mt-3 text-[30px] leading-[1.08] text-plum-900 md:text-[40px]">
    Questions patients ask first
  </h2>

  <div class="mt-[22px] max-w-3xl border-t border-plum-900/[0.12]">
    {
      faqs.map((f, i) => (
        <details class="group border-b border-plum-900/[0.09] py-[18px]" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-[18px]">
            <span class="font-display text-[18px] leading-[1.3] tracking-[-0.02em] text-plum-900">
              {f.q}
            </span>
            <span class="shrink-0 pt-1 text-rose-500 transition group-open:rotate-180">
              <Icon name="chevron" class="h-3.5 w-3.5" />
            </span>
          </summary>
          <p class="mt-3 text-[15px] leading-[1.7] text-plum-700">
            <span class="ph-mark">{f.a}</span>
          </p>
        </details>
      ))
    }
  </div>
</div>
</section>
