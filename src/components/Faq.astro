---
import { faqs } from '../data/site';
---

<section id="faq" class="bg-cream-100 py-20 lg:py-28">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <p class="text-xs font-medium tracking-[0.2em] text-rose-500 uppercase">
      Before you come in
    </p>
    <h2 class="mt-4 text-3xl leading-tight text-plum-900 sm:text-4xl">
      Questions patients ask first
    </h2>

    <div class="mt-10 divide-y divide-cream-200 border-y border-cream-200">
      {
        faqs.map((f, i) => (
          <details class="group py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left">
              <span class="font-display text-lg text-plum-900">{f.q}</span>
              <span class="mt-1 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-plum-900/15 text-plum-500 transition group-open:rotate-45">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 pr-12 leading-relaxed text-plum-700">
              <span class="ph-mark">{f.a}</span>
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
