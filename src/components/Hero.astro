---
import { existsSync } from 'node:fs';
import { doctor, social } from '../data/site';
import Icon from './Icon.astro';

// doctor.jpg — a real ~800×1000 headshot — fills the arch when present.
// Otherwise the 150px Instagram picture sits in it as a circle, which reads
// as a deliberate portrait treatment rather than a blurry stretched image.
const hasPhoto = existsSync(new URL(`../../public${doctor.photo}`, import.meta.url));
const hasAvatar = existsSync(new URL('../../public/images/avatar.jpg', import.meta.url));
---

<section id="top" class="relative overflow-hidden pb-[34px]">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-[180px] -right-20 -left-20 h-[520px] bg-[radial-gradient(50%_55%_at_60%_45%,var(--color-rose-100),transparent_72%)]"
  >
  </div>

  <div
    class="shell relative pt-7 md:grid md:grid-cols-[1.05fr_0.95fr] md:items-center md:gap-14"
  >
    <!-- Arch-topped portrait. Reads as considered rather than as a
         rectangular stock crop. -->
    <div
      class="relative grid h-[300px] place-items-center overflow-hidden rounded-t-[170px] rounded-b-xl bg-[linear-gradient(168deg,var(--color-rose-100),var(--color-sage-100))] p-[26px] text-center md:h-[460px] md:rounded-t-[240px]"
    >
      {
        hasPhoto ? (
          <img
            src={doctor.photo}
            alt={`${doctor.name}, ${doctor.title}`}
            width="800"
            height="1000"
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <div>
            {hasAvatar && (
              <img
                src="/images/avatar.jpg"
                alt={`${doctor.name}, ${doctor.title}`}
                width="150"
                height="150"
                class="mx-auto block h-[132px] w-[132px] rounded-full object-cover shadow-[0_20px_36px_-20px_rgba(46,28,37,0.45),0_0_0_5px_rgba(255,255,255,0.6)]"
              />
            )}
            <p class="mt-4 font-mono text-[9.5px] leading-relaxed tracking-[0.06em] text-plum-500/60 uppercase">
              professional portrait<br />→ public/images/doctor.jpg
            </p>
          </div>
        )
      }
    </div>

    <div>
      <p
        class="mt-[26px] text-[10.5px] tracking-[0.16em] text-rose-600 uppercase md:mt-0"
      >
        {doctor.eyebrow}
      </p>

      <h1
        class="opsz-display mt-3.5 text-[44px] leading-[0.98] tracking-[-0.04em] text-plum-900 md:text-[68px]"
      >
        {doctor.headline}{' '}
        <span class="font-light text-rose-600 italic">{doctor.headlineAccent}</span>
      </h1>

      <p class="mt-[18px] text-[16.5px] leading-[1.6] text-plum-700">
        Fertility, pregnancy and gynaecological care in North Delhi — from the doctor
        behind{' '}
        <a
          href={social.instagram}
          target="_blank"
          rel="noopener"
          class="text-plum-900 shadow-[inset_0_-1px_0_var(--color-rose-400)]"
        >
          {social.instagramHandle}
        </a>.
      </p>

      <a
        href="#book"
        class="mt-6 flex items-center justify-center gap-2.5 rounded-full bg-rose-500 px-6 py-[18px] text-[16px] font-medium text-white shadow-[0_18px_34px_-18px_rgba(166,60,85,0.6)] transition hover:bg-rose-600 md:inline-flex"
      >
        Book an appointment
        <Icon name="arrow" class="h-[15px] w-[15px]" />
      </a>
    </div>
  </div>
</section>
