---
import { testimonials } from '../data/site';
---

<section id="testimonials" class="bg-plum-900 pt-11 pb-[46px] text-cream-50">
  <div class="shell">
    <p class="text-[10.5px] tracking-[0.18em] text-rose-400 uppercase">
      In patients’ words
    </p>
    <h2 class="opsz-title mt-3 text-[30px] leading-[1.08] text-cream-50 md:text-[40px]">
      The part that does not show up on a degree
    </h2>
  </div>

  <div
    class="rail mx-auto mt-6 flex w-full max-w-[1120px] snap-x snap-mandatory gap-3 overflow-x-auto px-[18px] pb-1.5 md:flex-wrap md:overflow-visible md:px-10"
  >
    {
      testimonials.map((t) => (
        <figure class="flex shrink-0 basis-[288px] snap-start flex-col justify-between gap-[22px] rounded-[14px] bg-cream-100/[0.07] p-[22px] ring-1 ring-cream-100/[0.14] md:shrink md:basis-[300px] md:grow">
          <blockquote class="font-display text-[20px] leading-[1.38] tracking-[-0.02em] text-cream-100">
            {t.quote}
          </blockquote>
          <figcaption class="text-[11.5px] tracking-[0.06em] text-cream-100/55 uppercase">
            [Patient initials] ·{' '}
            <span class="ph-mark text-cream-50 normal-case tracking-normal">
              {t.context}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p
    class="shell mt-4 font-mono text-[10px] leading-[1.7] tracking-[0.05em] text-rose-400/80 uppercase"
  >
    All placeholders. Real, consented quotes only — check her council’s advertising
    rules first.
  </p>
</section>
