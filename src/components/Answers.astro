---
import { answers, doctor, social } from '../data/site';
import Icon from './Icon.astro';

/*
  Why this section exists — worth saying out loud in the pitch:

  Instagram is invisible to Google. Every explainer she has posted is
  unsearchable and gone down the feed within a day. The same content here is
  permanent, indexable, and ranks for exactly the questions women type at
  2am. Highest-leverage part of the site, and it costs her nothing new to
  make — she already writes it.

  A swipeable rail rather than a grid: six cards as a grid is most of a
  screen, as a rail it is one gesture.
*/
---

<section id="answers" class="pt-11 pb-10">
  <div class="shell">
    <p class="text-[10.5px] tracking-[0.18em] text-rose-600 uppercase">Answers</p>
    <h2 class="opsz-title mt-3 text-[30px] leading-[1.08] text-plum-900 md:text-[40px]">
      The questions she gets asked most
    </h2>
    <p class="mt-3 max-w-xl text-[15px] leading-[1.62] text-plum-500">
      The same explainers {doctor.instagramFollowers} people follow her for — written
      down, so you can find them again.
    </p>
  </div>

  <div
    class="rail mx-auto mt-[22px] flex w-full max-w-[1120px] snap-x snap-mandatory gap-3 overflow-x-auto px-[18px] pb-1.5 md:flex-wrap md:overflow-visible md:px-10"
  >
    {
      answers.map((q, i) => (
        <a
          href="#"
          class:list={[
            'flex h-[290px] shrink-0 basis-[232px] snap-start flex-col justify-between rounded-[14px] p-5 md:h-auto md:min-h-[210px] md:shrink md:basis-[300px] md:grow',
            i === 0
              ? 'bg-plum-900 text-cream-100'
              : 'bg-cream-100 text-plum-900 ring-1 ring-plum-900/[0.07]',
          ]}
        >
          <span
            class:list={[
              'font-mono text-[10.5px] tracking-[0.1em]',
              i === 0 ? 'text-rose-400' : 'text-plum-400',
            ]}
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <span>
            <span
              class:list={[
                'block font-display text-[24px] leading-[1.18] tracking-[-0.025em]',
                i === 0 ? 'text-cream-50' : 'text-plum-900',
              ]}
            >
              {q}
            </span>
            <span
              class:list={[
                'mt-3.5 inline-flex items-center gap-[7px] text-[13px] font-medium',
                i === 0 ? 'text-rose-400' : 'text-rose-600',
              ]}
            >
              Read
              <Icon name="arrow" class="h-[13px] w-[13px]" />
            </span>
          </span>
        </a>
      ))
    }
  </div>

  <p class="shell mt-3.5 text-[12px] text-plum-400">
    <span class="md:hidden">Swipe · </span>
    <span class="ph-mark">wording drafted from her posts, pending her approval</span>
    {' · '}
    <a href={social.instagram} target="_blank" rel="noopener" class="text-rose-600">
      Follow on Instagram
    </a>
  </p>
</section>
