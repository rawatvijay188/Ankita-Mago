---
import { answers, social, doctor } from '../data/site';
import Icon from './Icon.astro';

/*
  Why this section exists — worth saying out loud in the pitch:

  Instagram is invisible to Google. Every explainer she has ever posted is
  unsearchable, and disappears down the feed within a day. The same content
  restated here is permanent, indexable, and ranks for exactly the questions
  women type at 2am. It is the highest-leverage part of the site, and it
  costs her nothing new to make — she already writes it.

  Each of these should eventually become its own page at /answers/<slug>,
  with the post embedded and a booking CTA at the end. Cards for now.
*/
---

<section id="answers" class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="text-xs font-medium tracking-[0.2em] text-rose-500 uppercase">Answers</p>
      <h2 class="mt-4 text-3xl leading-tight text-plum-900 sm:text-4xl">
        The questions she gets asked most
      </h2>
      <p class="mt-4 text-lg text-plum-700">
        The same explainers <span class="ph-mark">{doctor.instagramFollowers}</span> people
        follow her for — written down, so you can find them again.
      </p>
    </div>
    <a
      href={social.instagram}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-full border border-plum-900/15 px-5 py-2.5 text-sm font-medium text-plum-900 transition hover:border-plum-900/35"
    >
      Follow on Instagram
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      answers.map((a) => (
        <a
          href="#"
          class="group flex flex-col justify-between rounded-2xl border border-cream-200 bg-white p-6 shadow-soft transition hover:shadow-lift"
        >
          <h3 class="text-lg leading-snug text-plum-900">{a.q}</h3>
          <p class="mt-3 text-sm leading-relaxed text-plum-500">
            <span class="ph-mark">{a.teaser}</span>
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-rose-600">
            Read
            <Icon name="arrow" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" />
          </span>
        </a>
      ))
    }
  </div>

  <p class="mt-8 text-sm text-plum-500">
    Note for review: these link nowhere yet. Each becomes its own page once
    Dr. Mago approves the wording — her words, not ours.
  </p>
</section>
