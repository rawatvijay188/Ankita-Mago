---
import { contact } from '../data/site';
import Icon from './Icon.astro';
---

<section id="visit" class="pt-11 pb-10">
  <div class="shell">
  <p class="text-[10.5px] tracking-[0.18em] text-rose-600 uppercase">Visit</p>
  <h2 class="opsz-title mt-3 text-[30px] leading-[1.08] text-plum-900 md:text-[40px]">
    Clinic hours &amp; location
  </h2>

  <div class="mt-[22px] max-w-2xl border-t border-plum-900/[0.12]">
    <div class="border-b border-plum-900/[0.09] py-4">
      <p class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">Clinic</p>
      <p class="mt-[7px] text-[15.5px] text-plum-900">
        <span class="ph-mark">{contact.clinicName}</span>
      </p>
      <p class="mt-1 text-[14px] text-plum-500">
        <span class="ph-mark">{contact.addressLine}</span>
      </p>
      <a
        href={contact.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-3 flex items-center justify-center gap-2 rounded-full border border-plum-900/[0.16] px-[18px] py-3 text-[14px] font-medium text-plum-900 transition hover:border-plum-900/40 md:inline-flex"
      >
        <Icon name="pin" class="h-[15px] w-[15px]" />
        Directions in Maps
      </a>
    </div>

    <div class="border-b border-plum-900/[0.09] py-4">
      <p class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">Hours</p>
      <dl class="mt-2 flex flex-col gap-2">
        {
          contact.hours.map((h) => (
            <div class="flex justify-between gap-4">
              <dt class="text-[14.5px] text-plum-900">{h.days}</dt>
              <dd class="text-[14.5px] text-plum-500">
                <span class="ph-mark">{h.time}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="border-b border-plum-900/[0.09] py-4">
      <p class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">Emergency</p>
      <p class="mt-[7px] text-[14px] leading-[1.6] text-plum-500">
        <span class="ph-mark">{contact.emergencyNote}</span>
      </p>
    </div>
  </div>

  <div class="mt-[22px] max-w-2xl rounded-[14px] bg-sage-100 p-[22px]">
    <div class="flex items-center gap-3">
      <span class="text-sage-600"><Icon name="chat" class="h-[21px] w-[21px]" /></span>
      <h3 class="text-[19px] tracking-[-0.02em] text-plum-900">Not in Delhi?</h3>
    </div>
    <p class="mt-3 text-[14.5px] leading-[1.65] text-plum-700">
      <span class="ph-mark">{contact.teleconsult}</span> — anything needing an
      examination, scan or procedure is seen in clinic.
    </p>
  </div>
</div>
</section>
