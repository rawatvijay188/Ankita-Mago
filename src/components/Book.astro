---
import { booking } from '../data/site';

/*
  Four taps rather than a wall of text fields — most of this form is
  choosing, not typing, which is the difference between a booking that
  happens on a phone and one that doesn't.

  TODO (before launch): no backend. Point `action` at Formspree /
  Web3Forms / the clinic's booking system, or swap the block for a Practo
  embed. Never collect medical details here — name, number and a preferred
  time are enough.
*/

// Real radios, visually hidden, so the form actually submits and is
// keyboard- and screen-reader-navigable. The pill is the label.
const pill =
  'block cursor-pointer rounded-full bg-white px-[17px] py-3 text-[14px] text-plum-700 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.12)] transition peer-checked:bg-plum-900 peer-checked:text-cream-50 peer-checked:shadow-none peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400';
const input = 'peer sr-only';
---

<section
  id="book"
  class="scroll-mt-[70px] border-t border-plum-900/[0.07] bg-cream-100 px-[18px] pt-11 pb-10 md:px-10"
>
  <h2 class="opsz-title text-[30px] leading-[1.08] text-plum-900 md:text-[40px]">
    Request an appointment
  </h2>
  <p class="mt-3 text-[15px] leading-[1.62] text-plum-500">
    Four taps. The clinic confirms your slot by phone, usually the same day.
  </p>

  <form action="#" method="post" class="mt-7 flex max-w-[620px] flex-col gap-[26px]">
    <fieldset>
      <legend class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">
        1 · What is this about?
      </legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          booking.reasons.map((r, i) => (
            <label>
              <input type="radio" name="reason" value={r} checked={i === 0} class={input} />
              <span class={pill}>{r}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">
        2 · In clinic or online?
      </legend>
      <div class="mt-3 grid grid-cols-2 gap-2">
        {
          booking.modes.map((m, i) => (
            <label>
              <input type="radio" name="mode" value={m} checked={i === 0} class={input} />
              <span class="grid min-h-14 cursor-pointer place-items-center rounded-xl bg-white p-3 text-[14px] text-plum-700 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.12)] transition peer-checked:bg-plum-900 peer-checked:text-cream-50 peer-checked:shadow-none peer-focus-visible:ring-2 peer-focus-visible:ring-rose-400">
                {m}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">
        3 · When suits you?
      </legend>
      <div class="rail mt-3 flex gap-2 overflow-x-auto pb-1 md:flex-wrap md:overflow-visible">
        {
          booking.times.map((t) => (
            <label class="shrink-0">
              <input type="radio" name="time" value={t} class={input} />
              <span class={pill}>{t}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-[10.5px] tracking-[0.12em] text-plum-400 uppercase">
        4 · How do we reach you?
      </legend>
      <label class="mt-3 block">
        <span class="sr-only">Your name</span>
        <input
          type="text"
          name="name"
          placeholder="Your name"
          required
          class="w-full rounded-xl bg-white px-[18px] py-4 text-[16px] text-plum-900 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.12)] outline-none transition placeholder:text-plum-400 focus:shadow-[inset_0_0_0_2px_var(--color-rose-400)]"
        />
      </label>
      <label class="mt-2.5 block">
        <span class="sr-only">Phone number</span>
        <input
          type="tel"
          name="phone"
          inputmode="tel"
          placeholder="Phone number"
          required
          class="w-full rounded-xl bg-white px-[18px] py-4 text-[16px] text-plum-900 shadow-[inset_0_0_0_1px_rgba(46,28,37,0.12)] outline-none transition placeholder:text-plum-400 focus:shadow-[inset_0_0_0_2px_var(--color-rose-400)]"
        />
      </label>
    </fieldset>

    <div>
      <button
        type="submit"
        class="w-full rounded-full bg-rose-500 px-6 py-[19px] text-[16.5px] font-medium text-white transition hover:bg-rose-600"
      >
        Request appointment
      </button>
      <p class="mt-3 text-[12px] leading-[1.6] text-plum-400">
        No medical details in this form, please.{' '}
        <span class="ph-mark font-mono text-[10.5px]">[TODO: no backend yet]</span>
      </p>
    </div>
  </form>
</section>
