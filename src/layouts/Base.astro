---
import '../styles/global.css';
import { doctor, contact, social } from '../data/site';
import { IS_DRAFT, SHOW_TAGS } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${doctor.name} — ${doctor.title}`,
  description = doctor.tagline,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: doctor.name,
  medicalSpecialty: ['Obstetric', 'Gynecologic'],
  description: doctor.tagline,
  // Links the site to the Instagram account Google already knows about.
  sameAs: [social.instagram, social.threads],
  telephone: contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.addressLine,
    addressLocality: 'Delhi',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {IS_DRAFT && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={doctor.name} />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${doctor.name} — ${doctor.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og.png', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <script is:inline>
      /*
        Browsers restore the previous scroll position on reload, so the page
        appears to open partway down — noticeable in dev, where the server
        hot-reloads on every save. Opening the site should always start at
        the top; an explicit #hash still wins.

        `instant` because scroll-behavior is smooth, and we do not want to
        watch the page animate up from wherever it was.
      */
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) {
        window.scrollTo({ top: 0, behavior: 'instant' });
        addEventListener(
          'DOMContentLoaded',
          () => window.scrollTo({ top: 0, behavior: 'instant' }),
          { once: true }
        );
      }
    </script>
  </head>
  <body class={SHOW_TAGS ? 'tags-on' : ''}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-plum-900 focus:px-5 focus:py-2 focus:text-cream-50"
    >
      Skip to content
    </a>

    <!--
      Full-bleed sections, centred content. Every section paints edge to
      edge and constrains its own contents with `.shell`, so backgrounds
      never stop short of the window and there are no gutters at any width.
    -->
    <div class="relative">
      {
        IS_DRAFT && (
          <div class="flex items-center justify-center gap-2 bg-plum-900 px-4 py-[7px] text-[10px] tracking-[0.08em] text-cream-100/70 uppercase">
            <span class="h-1 w-1 rounded-full bg-rose-400" />
            Draft — details unconfirmed
          </div>
        )
      }
      <slot />
    </div>
  </body>
</html>
