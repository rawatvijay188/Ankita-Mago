---
import '../styles/global.css';
import { doctor, contact, social } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

/*
  DRAFT flag. While true the page is marked noindex/nofollow and carries a
  visible review banner.

  This matters: the page names a real doctor and lists credentials that are
  sourced from directories rather than confirmed with her. It must not be
  indexed, and nobody landing on it should mistake it for her official site.
  Set to false only once the content is confirmed and she has approved it.
*/
const IS_DRAFT = true;

const {
  title = `${doctor.name} — ${doctor.title}`,
  description = doctor.tagline,
} = Astro.props;

// Search engines read this. Every bracketed value must be replaced
// before launch or it will be indexed as-is.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: doctor.name,
  medicalSpecialty: ['Obstetric', 'Gynecologic'],
  description: doctor.tagline,
  // Links the site to the Instagram account Google already knows about,
  // which helps the two rank as one entity.
  sameAs: [social.instagram, social.threads],
  telephone: contact.phone,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.addressLines[0],
    addressLocality: contact.addressLines[1],
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {IS_DRAFT && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={doctor.name} />
    {/* Link previews — this is how the URL renders when shared to
        WhatsApp or Instagram, which is how most people will receive it. */}
    <meta property="og:image" content={new URL('/images/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${doctor.name} — ${doctor.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og.png', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-plum-900 focus:px-5 focus:py-2 focus:text-cream-50"
    >
      Skip to content
    </a>
    {
      IS_DRAFT && (
        <div class="bg-plum-900 px-4 py-2 text-center text-xs text-cream-100">
          Draft for review — highlighted details are unconfirmed and not yet
          approved by Dr. Mago. Not her official website.
        </div>
      )
    }
    <slot />
  </body>
</html>
